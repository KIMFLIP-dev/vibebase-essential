# =====================================================
# VIBEBASE ESSENTIAL 환경 변수
# 이 파일을 .env.local로 복사한 뒤 값을 채우세요.
# 필수 키가 누락되면 lib/env.ts가 기동 시 명확한 에러를 냅니다.
# =====================================================

# --- Supabase (필수) ---
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PortOne V2 결제 (필수) ---
# https://admin.portone.io → 결제 연동
# 테스트/운영 전환은 NEXT_PUBLIC_PORTONE_CHANNEL_KEY만 교체 (Vercel은 재배포 필요)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 웹훅 서명 검증 시크릿 — PortOne 콘솔 → 연동 정보 → 결제알림(Webhook) 관리 →
# 결제모듈 V2 탭에서 아래 웹훅 URL을 등록·저장한 뒤 "웹훅 시크릿 발급"으로 발급:
#   https://<실제 배포 도메인>/api/webhooks/portone
# 실연동/테스트 모드별로 URL과 시크릿이 따로 관리된다 — 배포 환경엔 실연동
# 시크릿, 로컬엔 테스트 시크릿을 넣을 것. (로컬은 웹훅이 도달하지 않으므로
# 비워둬도 되고, 테스트가 필요하면 ngrok 등 터널 주소로 등록)
PORTONE_WEBHOOK_SECRET=

# --- 사이트 (필수) ---
# SEO/OG 절대 URL 생성에 사용. 로컬: http://localhost:3000 / 운영: https://example.com
NEXT_PUBLIC_SITE_URL=

# --- 첫 관리자 (옵셔널 — SQL 없이 관리자 지정) ---
# 이 이메일로 가입/소셜 로그인하면 자동으로 super_admin이 부여됩니다.
# 역할이 없는 계정에만 1회 적용되므로 부여 후에는 지워도 됩니다.
# 미설정 시 install.sql 하단의 SQL로 직접 지정하세요.
ADMIN_EMAIL=

# --- 이메일 (옵셔널 — 미설정 시 발송을 건너뜁니다) ---
# https://resend.com → API Keys. EMAIL_FROM 도메인은 Resend에서 인증 필요
RESEND_API_KEY=
EMAIL_FROM=
